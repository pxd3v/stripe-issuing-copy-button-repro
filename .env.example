# Test mode only. Never put a live key here.

# Required for both parts of the repro.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Required only for the "Run full flow" part.
STRIPE_SECRET_KEY=sk_test_replace_me
ISSUING_CARD_ID=ic_replace_me

# Optional: set only if the Issuing card lives on a connected account.
STRIPE_ACCOUNT=

# Optional: override if your Stripe.js expects a different API version for the ephemeral key.
STRIPE_API_VERSION=
